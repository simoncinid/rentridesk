# URL del bridge rentridesk. In locale il valore predefinito è http://localhost:3001.
VITE_API_BASE_URL=http://localhost:3001

# Host pubblico usato per canonical, Open Graph, sitemap e dati strutturati.
VITE_PUBLIC_SITE_URL=https://rentridesk.it

# Facoltativo: sovrascrive l'endpoint lead predefinito.
# In produzione su Vercel il default è /api/leads (stesso dominio).
VITE_LEAD_ENDPOINT=

# Su Vercel (Project Settings → Environment Variables):
# GMAIL_PASSWORD=<app password Gmail per reservationwebbitz@gmail.com>
