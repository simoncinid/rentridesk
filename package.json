{
  "name": "rentridesk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --parallel --filter @rentridesk/web --filter @rentridesk/rentri-bridge dev",
    "dev:web": "pnpm --filter @rentridesk/web dev",
    "dev:bridge": "pnpm --filter @rentridesk/rentri-bridge dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify": "pnpm lint && pnpm typecheck && pnpm verify:unit && pnpm build",
    "verify:unit": "vitest run",
    "verify:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "verify:e2e": "playwright test",
    "db:migrate": "nhost up --apply-seeds=false",
    "db:seed": "psql \"$DATABASE_URL\" -f nhost/seeds/default.sql",
    "graphql:codegen": "graphql-codegen --config codegen.ts",
    "rentri:sync-codifications": "tsx scripts/rentri-sync-codifications.ts",
    "rentri:check-updates": "tsx scripts/rentri-check-updates.ts",
    "rentri:validate-fixtures": "vitest run packages/domain/src/xfir.test.ts --passWithNoTests",
    "documents:verify-hashes": "tsx scripts/documents-verify-hashes.ts",
    "jobs:run-once": "tsx scripts/jobs-run-once.ts",
    "jobs:retry-dead-letter": "tsx scripts/jobs-retry-dead-letter.ts",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@graphql-codegen/cli": "latest",
    "@graphql-codegen/client-preset": "latest",
    "@playwright/test": "latest",
    "@types/node": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "prettier": "latest",
    "tsx": "latest",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vitest": "latest"
  }
}
